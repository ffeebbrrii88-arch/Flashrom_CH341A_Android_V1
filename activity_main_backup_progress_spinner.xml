<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:orientation="vertical"
    android:background="#212121"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:text="FLASHROM CH341A ANDROID"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <TextView
        android:text="SPI Programmer • Root Mode"
        android:textSize="16sp"
        android:textColor="#BBBBBB"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <TextView
        android:id="@+id/tvStatus"

        android:text="STATUS&#10;CH341A : NOT CONNECTED&#10;CHIP : -&#10;SIZE : -"

        android:textColor="#00FF00"
        android:textSize="16sp"

        android:background="#111111"
        android:padding="12dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <TextView
        android:id="@+id/tvBackup"

        android:text="LAST BACKUP&#10;Belum ada backup"

        android:textColor="#00FFFF"
        android:textSize="15sp"

        android:background="#111111"
        android:padding="12dp"

        android:layout_marginTop="8dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <ProgressBar
        android:id="@+id/progressRead"

        android:layout_marginTop="8dp"

        android:visibility="gone"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <Button
        android:id="@+id/btnDetect"

        android:text="DETECT CH341A + IC"

        android:layout_marginTop="12dp"

        android:layout_width="match_parent"
        android:layout_height="55dp"/>


    <Button
        android:id="@+id/btnRead"

        android:text="READ BACKUP BIN"

        android:layout_width="match_parent"
        android:layout_height="55dp"/>


    <Button
        android:text="WRITE BIN"

        android:layout_width="match_parent"
        android:layout_height="55dp"/>


    <Button
        android:text="VERIFY"

        android:layout_width="match_parent"
        android:layout_height="55dp"/>



    <TextView

        android:text="CONSOLE LOG"

        android:textColor="#FFFFFF"
        android:textSize="18sp"

        android:layout_marginTop="10dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>



    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1">


        <TextView

            android:id="@+id/tvLog"

            android:text="Ready...\n"

            android:textColor="#00FF00"

            android:textSize="14sp"

            android:background="#000000"

            android:padding="10dp"

            android:fontFamily="monospace"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"/>


    </ScrollView>


</LinearLayout>
